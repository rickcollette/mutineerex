; REMMS constants. These describe the new REMMS API, not the old MMS ABI.

.ifndef REMMS_BASE
REMMS_BASE = $1E00
.endif

REMMS_DISCOVERY = $03E8
REMMS_VERSION_MAJOR = 1
REMMS_VERSION_MINOR = 10

; Resident layout. These match the proven MMS resident memory map.
REMMS_PUBLIC_OFFSET  = $60
REMMS_PUBLIC_SIZE    = $40
REMMS_COMMAND_OFFSET = $A0
REMMS_COMMAND_SIZE   = $10
REMMS_SESSION_OFFSET = $B0

REMMS_PUBLIC  = REMMS_BASE+REMMS_PUBLIC_OFFSET
REMMS_COMMAND = REMMS_BASE+REMMS_COMMAND_OFFSET
REMMS_SESSION = REMMS_BASE+REMMS_SESSION_OFFSET

REMMS_MODE_LOCAL = 0
REMMS_MODE_HOST  = 1

REMMS_ROUTE_LOCAL  = 0
REMMS_ROUTE_REMOTE = 1
REMMS_ROUTE_BOTH   = 2

; IOCB 5 is reserved exclusively for the resident R: channel. IOCB 6 belongs
; to BASIC GRAPHICS/S: and must never be used for the modem.
REMMS_R_IOCB = 5*16
REMMS_K_IOCB = 4*16
REMMS_R_OPEN_AUX = $0D
; The 850 defines selectors 14 and 15 as 9600 baud. Altirra 4.40 full
; emulation requires selector 15 for modem command responses and selector 14
; for the connected data stream.
REMMS_R_BAUD_CODE = 14
REMMS_R_WAIT_BAUD_CODE = 15
REMMS_R_TIMEOUT = 240
; XIO 34 control mask used by the established REMMS/MOE open sequence.
; Block output is not used while waiting for calls.
REMMS_R_CONTROL_READY = $F0
; RVRHAND XIO 42 capability bits. An ordinary 850 does not implement the
; identify command and receives the full default contract below.
REMMS_R_CAP_EXTERNAL = $01
REMMS_R_CAP_DTR      = $02
REMMS_R_CAP_CARRIER  = $04
REMMS_R_CAP_HANGUP   = $08
REMMS_R_CAP_DRAIN    = $10
REMMS_R_CAP_850_DEFAULT = $1F
; The external concurrent input buffer occupies the otherwise unused page-four
; printer buffer ($03FD-$047C).  A full 128 bytes prevents an XMODEM frame from
; overflowing while BASIC hands control to the native block reader.
REMMS_R_CONCURRENT_BUFFER = $03FD
REMMS_R_CONCURRENT_LENGTH = $80
REMMS_R_INPUT_LIMIT = 60
REMMS_XON = $11
REMMS_XOFF = $13

